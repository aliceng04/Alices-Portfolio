---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
// <Gallery images={[{ src: shot1, alt: '…', caption: '…' }]} /> — click to enlarge.
interface Props { images: { src: ImageMetadata; alt: string; caption?: string }[]; caption?: string }
const { images, caption } = Astro.props;
const cols = Math.max(3, Math.min(images.length, 5)); // keep phone shots a sensible size even with 1–2 images
const round = 'inline-flex size-12 items-center justify-center rounded-full bg-canvas text-ink';
---
<figure class="block-wide" data-gallery>
  <div class="-mx-4 flex snap-x gap-3 overflow-x-auto px-4 sm:mx-0 sm:grid sm:gap-4 sm:overflow-visible sm:px-0 sm:[grid-template-columns:repeat(var(--cols),minmax(0,1fr))]" style={`--cols:${cols}`}>
    {images.map((img, i) => (
      <button type="button" data-gallery-open={i} class="w-48 shrink-0 snap-start overflow-hidden rounded-sm sm:w-auto" aria-label={`Enlarge: ${img.alt}`}>
        <Image src={img.src} alt={img.alt} widths={[480, 960]} sizes="(min-width: 640px) 25vw, 192px" class="h-auto w-full transition hover:scale-[1.02]" />
      </button>
    ))}
  </div>
  {caption && <figcaption class="t-caption mt-3 text-muted">{caption}</figcaption>}

  <dialog class="m-0 h-full max-h-none w-full max-w-none bg-black/85 p-6 text-white backdrop:bg-transparent lg:p-12" data-gallery-dialog>
    <div class="flex h-full flex-col gap-6">
      <div class="flex items-center">
        <span class="t-link mr-auto" data-gallery-counter></span>
        <button type="button" class={round} data-gallery-close aria-label="Close"><Icon name="x" /></button>
      </div>
      <div class="flex min-h-0 flex-1 items-center gap-6">
        <button type="button" class={round} data-gallery-prev aria-label="Previous image"><Icon name="chevron-left" /></button>
        <div class="flex min-h-0 flex-1 items-center justify-center self-stretch">
          {images.map((img, i) => (
            <Image src={img.src} alt={img.alt} widths={[1200, 2000]} sizes="90vw" data-gallery-full={i} hidden class="max-h-full max-w-full rounded-md object-contain" />
          ))}
        </div>
        <button type="button" class={round} data-gallery-next aria-label="Next image"><Icon name="chevron-right" /></button>
      </div>
      <p class="t-body min-h-6 text-center" data-gallery-caption></p>
    </div>
  </dialog>
  <script type="application/json" data-gallery-captions set:html={JSON.stringify(images.map((i) => i.caption ?? ''))} />
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-dialog]')!;
    const full = [...root.querySelectorAll<HTMLElement>('[data-gallery-full]')];
    const captions: string[] = JSON.parse(root.querySelector('[data-gallery-captions]')!.textContent || '[]');
    let i = 0;
    const show = (n: number) => {
      i = (n + full.length) % full.length;
      full.forEach((el, k) => (el.hidden = k !== i));
      root.querySelector('[data-gallery-counter]')!.textContent = `${i + 1} of ${full.length}`;
      root.querySelector('[data-gallery-caption]')!.textContent = captions[i];
    };
    root.querySelectorAll<HTMLElement>('[data-gallery-open]').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.galleryOpen)); dialog.showModal(); }),
    );
    root.querySelector('[data-gallery-close]')!.addEventListener('click', () => dialog.close());
    root.querySelector('[data-gallery-prev]')!.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-gallery-next]')!.addEventListener('click', () => show(i + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
  });
</script>
