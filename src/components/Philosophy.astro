---
import { profile } from '../data/profile';
// Product philosophy: love for the product, then the formula that grows product thinking.
// On scroll each term lands in turn, the × and = pop in between, and the result lights up last.
const { title, lead, terms, result, footnote } = profile.philosophy;
const step = 0.22;
---
<section class="mx-auto max-w-[1120px] px-4 pb-20 lg:px-0 lg:pb-30">
  <div class="mb-6 flex flex-col gap-2 lg:mb-8" data-reveal>
    <span class="t-label text-accent">My product philosophy</span>
    <h2 class="t-h2">{title}</h2>
    <p class="t-body max-w-[640px] text-muted">{lead}</p>
  </div>

  <div class="formula flex flex-col items-stretch gap-2 lg:flex-row lg:gap-3" data-reveal>
    {terms.map((t, i) => (
      <>
        {i > 0 && <span class="op" style={`--d:${i * step * 2 - step}s`} aria-hidden="true">×</span>}
        <div class="term flex flex-1 flex-col gap-1 rounded-sm border border-hairline bg-canvas p-4 lg:p-5" style={`--d:${i * step * 2}s`}>
          <span class="t-title">{t.name}</span>
          <span class="t-small text-muted">{t.note}</span>
        </div>
      </>
    ))}
    <span class="op" style={`--d:${terms.length * step * 2 - step}s`} aria-hidden="true">=</span>
    <div class="term result relative flex flex-1 flex-col gap-1 overflow-hidden rounded-sm bg-primary p-4 text-on-primary lg:p-5" style={`--d:${terms.length * step * 2}s`}>
      <span class="t-title">{result.name}</span>
      <span class="t-small opacity-85">{result.note}</span>
      <span class="shine" aria-hidden="true"></span>
    </div>
  </div>
  <p class="t-small mt-4 text-muted" data-reveal style="--delay:0.2s">{footnote}</p>
</section>

<style>
  .op { align-self: center; font-size: 28px; line-height: 1; font-weight: 300; color: var(--accent); }
  .shine { position: absolute; inset: 0; background: linear-gradient(110deg, transparent 35%, rgb(255 255 255 / 0.28) 50%, transparent 65%); transform: translateX(-100%); }

  /* Only with JS, so nothing stays hidden without it. */
  :global(html.js) .formula .term { opacity: 0; transform: translateY(14px); transition: opacity 0.5s, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: var(--d); }
  :global(html.js) .formula .op { opacity: 0; transform: scale(0.3); transition: opacity 0.3s, transform 0.5s cubic-bezier(0.3, 1.8, 0.5, 1); transition-delay: var(--d); }
  :global(html.js) .formula.is-in .term, :global(html.js) .formula.is-in .op { opacity: 1; transform: none; }
  :global(html.js) .formula.is-in .shine { animation: shine 3.2s ease-in-out calc(var(--d, 0s) + 1.6s) infinite; }
  .term:not(.result):hover { border-color: var(--accent); }
  @keyframes shine { 0% { transform: translateX(-100%); } 40%, 100% { transform: translateX(100%); } }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .formula .term, :global(html.js) .formula .op { opacity: 1; transform: none; transition: none; }
    :global(html.js) .formula.is-in .shine { animation: none; }
  }
</style>
